# Configuracion local del backoffice. Copiar a .env y ajustar.
# NO contiene credenciales: el login se hace contra el API con un operador de plataforma.

# Puerto del backoffice JSF (la API de plataforma escucha en 9094).
SERVER_PORT=9096

# Endpoint del API de plataforma (mindalai-management-api).
API_HOST=http://localhost
API_PORT=9094
# Timeout de conexion y lectura hacia el API. Acepta 5s, 5000ms, etc.
API_TIMEOUT=5s

# Duracion de la sesion del navegador.
SESSION_TIMEOUT=30m

# Cookie de sesion. Secure=true es el valor de produccion; en local sobre
# http://localhost debe ir false o el navegador no devolveria la cookie.
SESSION_COOKIE_SECURE=false
